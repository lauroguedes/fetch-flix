APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Media API ---------------------------------------------------------------

# Required for /api/v1/discover. Without it that endpoint returns 503
# resolver_unavailable, which is an operator error rather than a client one.
YOUTUBE_API_KEY=

# search.list costs 100 units of this per call, shared by every consumer.
YOUTUBE_DAILY_QUOTA=10000
# Held back for scheduled category warming so live search cannot starve it.
YOUTUBE_QUOTA_RESERVED=4000

# Path to the yt-dlp binary and where it caches player JS. The cache must be
# writable and persistent: cold, an extraction takes ~5-10s instead of ~1-2s,
# which does not fit the client's 12s ceiling.
YT_DLP_BINARY=yt-dlp
# YT_DLP_CACHE_DIR=

# Leave unset. Overriding the player client is a bot-check mitigation that can
# make YouTube drop progressive formats and return URLs that 403 on download;
# validate with the `network` test group before setting it.
# YT_DLP_PLAYER_CLIENTS=
# YT_DLP_PROXY=

# Redis is expected in production: quota counters need atomic increments and
# single-flight resolution needs fast locks.
# CACHE_STORE=redis
# QUEUE_CONNECTION=redis
