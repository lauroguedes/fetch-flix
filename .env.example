APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Which proxies may set X-Forwarded-*. Unauthenticated rate limits are keyed by
# client address, so trusting a hop that is not really in front of the app lets
# a caller spoof its way past them. The default covers nginx on the same host;
# add a CDN's ranges here, or `*` if the app is genuinely unreachable except
# through a proxy.
TRUSTED_PROXIES=127.0.0.1,::1

VITE_APP_NAME="${APP_NAME}"

# Ceiling on every issued API token, in minutes (365 days). Tokens are handed
# out by an operator and there is no self-serve refresh, so this is long — but a
# token that never expires is a leak that never closes. `tenant:token
# --expires-in-days` sets a tighter per-token expiry.
SANCTUM_TOKEN_EXPIRATION=525600

# --- Media API ---------------------------------------------------------------

# Required for /api/v1/discover. Without it that endpoint returns 503
# resolver_unavailable, which is an operator error rather than a client one.
YOUTUBE_API_KEY=

# search.list costs 100 units of this per call, shared by every consumer.
YOUTUBE_DAILY_QUOTA=10000
# Held back for scheduled category warming so live search cannot starve it.
YOUTUBE_QUOTA_RESERVED=4000

# Absolute path to the yt-dlp binary, and extra PATH entries for the JavaScript
# runtime it needs to solve YouTube's `n` challenge. PHP-FPM has a narrower PATH
# than a shell: without the runtime yt-dlp exits zero while dropping every
# format that requires a PO token, so a video that resolves from a terminal
# returns media_missing when served over the web. The worktree setup hook fills
# both in from the shell that created the worktree.
YT_DLP_BINARY=yt-dlp
YT_DLP_PATH=

# Where the binary caches player JS. Must be writable and persistent: cold, an
# extraction takes ~5-10s instead of ~1-2s, which does not fit the client's 12s
# ceiling.
# YT_DLP_CACHE_DIR=

# Pinned, because the unpinned default does not work. Measured 2026-08-22: it
# extracts fine and 403s on every download. Two clients so one breaking degrades
# to the other. Re-validate with `php artisan test --group=network` before
# changing.
YT_DLP_PLAYER_CLIENTS=mweb,tv_simply
# YT_DLP_PROXY=

# Media storage: resolved media is served from our own disk behind a signed URL.
MEDIA_DISK_DRIVER=local
MEDIA_RETENTION_DAYS=30
MEDIA_SIGNED_TTL=21600
MEDIA_MAX_BYTES=524288000

# Cloudflare R2 or S3, read when MEDIA_DISK_DRIVER=s3. Stock Laravel names, so
# the `media` disk needs no namespace of its own. For R2 the region is `auto`
# and the endpoint is the account endpoint, not the bucket URL.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
